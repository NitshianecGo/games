<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Anime ICQ Master — Global Walkie-Talkie 💕</title>
    
    <link rel="shortcut icon" href="data:image/x-icon;," type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;700&display=swap" rel="stylesheet">

    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <style>
        :root {
            --color-primary: #5c3d46;
            --color-pink-bg: #fff0f5;
            --color-main: #ff85a2;
            --color-secondary: #ffb3c6;
            --color-accent: #a3c4f3;
            --color-purple: #c8b6ff;
            --color-card-bg: #ffffff;
            --color-shadow: rgba(255, 133, 162, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0; padding: 0;
            font-family: 'Comfortaa', cursive, sans-serif;
            font-size: 11px;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body, html {
            width: 100%; height: 100%; height: 100dvh;
            background: linear-gradient(135deg, #fde2e4 0%, #c8b6ff 100%);
            display: flex; justify-content: center; align-items: center;
            overflow: hidden;
        }

        .icq-app {
            width: 100%; max-width: 480px;
            height: 100%; height: 100dvh;
            background: var(--color-pink-bg);
            border: 3px solid var(--color-secondary);
            border-radius: 16px;
            display: flex; flex-direction: column;
            box-shadow: 0 15px 35px var(--color-shadow);
            position: relative; overflow: hidden;
        }

        #loading-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: var(--color-pink-bg); z-index: 1000;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s ease;
        }

        .spinner {
            border: 5px solid #ffe5ec; border-top: 5px solid var(--color-main);
            border-radius: 50%; width: 45px; height: 45px;
            margin-bottom: 15px; animation: spin 1s linear infinite;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }

        .window-titlebar {
            background: linear-gradient(90deg, var(--color-main) 0%, var(--color-secondary) 100%);
            padding: 8px 12px; display: flex; align-items: center; justify-content: space-between;
            color: #ffffff; font-weight: bold; font-size: 12px; flex-shrink: 0;
        }

        .btn-exit {
            background: linear-gradient(180deg, #ff758f 0%, #ff4d6d 100%);
            border: none; color: white; font-weight: bold; font-size: 10px;
            padding: 4px 10px; border-radius: 12px; cursor: pointer;
        }

        #login-screen {
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            flex: 1; padding: 20px;
        }

        .login-card {
            background: var(--color-card-bg); border: 2px solid #ffccd5;
            border-radius: 16px; padding: 25px; width: 100%; max-width: 320px; text-align: center;
        }

        .input-field {
            width: 100%; padding: 10px; border: 2px solid #ffc2d1;
            border-radius: 10px; margin: 4px 0 14px 0; outline: none;
            background: #fff5f7; color: var(--color-primary);
        }

        .btn-green-rounded {
            width: 100%; padding: 10px;
            background: linear-gradient(90deg, var(--color-main) 0%, var(--color-purple) 100%);
            border: none; border-radius: 20px; color: white; font-weight: bold; cursor: pointer;
        }

        #chat-screen { display: none; flex: 1; flex-direction: column; min-height: 0; }
        #chat-screen.active { display: flex; }

        .action-toolbar {
            background: #ffffff; padding: 6px; display: flex; gap: 6px;
            border-bottom: 2px solid #ffe5ec; overflow-x: auto;
        }

        .tool-btn {
            padding: 4px 10px; background: #fff0f5; border: 1.5px solid #ffc2d1;
            border-radius: 12px; cursor: pointer; font-weight: bold; color: var(--color-primary);
            white-space: nowrap;
        }

        .chat-main-layout { display: flex; flex: 1; min-height: 0; }
        .chat-left-side { flex: 1; display: flex; flex-direction: column; padding: 8px; gap: 8px; min-width: 0; }
        
        .chat-right-side {
            width: 110px; padding: 8px; display: flex; flex-direction: column;
            gap: 8px; align-items: center; border-left: 2px dashed #ffccd5; background: #fff8fa;
        }

        .avatar-box {
            width: 55px; height: 55px; border: 2px solid var(--color-secondary);
            background: #ffe5ec; display: flex; align-items: center; justify-content: center;
            border-radius: 50%; font-size: 22px;
        }

        .video-stream-box {
            width: 95px; height: 95px; border: 2px solid var(--color-main);
            background: #1a1a2e; border-radius: 12px; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            position: relative; cursor: pointer;
        }

        .video-stream-box video { width: 100%; height: 100%; object-fit: cover; }
        .video-stream-box.fullscreen {
            position: absolute; top: 0; left: 0; width: 100% !important; height: 100% !important;
            z-index: 300; border-radius: 0;
        }

        .video-placeholder { color: #ffccd5; font-size: 8px; text-align: center; position: absolute; padding: 4px; }

        .messages-box {
            flex: 1; background: #ffffff; border: 2px solid #ffccd5;
            border-radius: 12px; padding: 10px; overflow-y: auto;
            display: flex; flex-direction: column; gap: 8px;
        }

        .msg-item { display: flex; flex-direction: column; gap: 2px; }
        .msg-header-text { font-weight: bold; color: #ff4d6d; font-size: 10px; }
        .msg-header-text.self { color: #7209b7; }
        .msg-content {
            font-size: 11px; color: var(--color-primary); background: #fff0f3;
            padding: 6px 10px; border-radius: 10px; display: inline-block; max-width: 90%;
        }

        .input-box {
            height: 45px; background: #ffffff; border: 2px solid #ffccd5;
            border-radius: 10px; padding: 6px; outline: none; resize: none;
        }

        .input-toolbar { display: flex; justify-content: space-between; align-items: center; }

        .ptt-bar {
            padding: 8px; background: #ffe5ec; border-top: 2px solid #ffccd5;
            display: flex; gap: 8px;
        }

        .ptt-button {
            flex: 1; padding: 10px; background: linear-gradient(90deg, var(--color-main) 0%, var(--color-secondary) 100%);
            border: none; color: white; font-weight: bold; border-radius: 12px; cursor: pointer; text-align: center;
        }

        .ptt-button.active {
            background: linear-gradient(90deg, #ff4d6d 0%, #c77dff 100%);
            animation: pulseActive 1s infinite alternate;
        }

        @keyframes pulseActive { 0% { transform: scale(1); } 100% { transform: scale(1.02); } }
    </style>
</head>
<body>

    <div class="icq-app">
        <div id="loading-screen">
            <div class="spinner"></div>
            <div style="font-weight:bold; color:var(--color-primary);">Подключение к сети... ✨</div>
        </div>

        <div class="window-titlebar">
            <span id="app-header-title">✨ Anime ICQ Walkie-Talkie ✨</span>
            <button id="exit-btn" class="btn-exit" style="display:none;" onclick="logout()">Выйти</button>
        </div>

        <div id="login-screen">
            <div class="login-card">
                <div style="font-size: 32px; margin-bottom: 8px;">🌏</div>
                <div style="font-weight:bold; color:var(--color-primary); margin-bottom:12px;">РФ ↔ Корея Чат</div>
                
                <input type="text" id="username-input" class="input-field" placeholder="Твое имя" maxlength="16">
                <input type="text" id="room-input" class="input-field" placeholder="Название комнаты" maxlength="20">

                <button class="btn-green-rounded" onclick="startSession()">Войти в эфир ✨</button>
            </div>
        </div>

        <div id="chat-screen">
            <div class="action-toolbar">
                <div class="tool-btn" onclick="document.getElementById('file-input').click()">📁 Отправить медиа</div>
                <input type="file" id="file-input" accept="image/*" style="display:none;" onchange="handleFileSelect(event)">
            </div>

            <div class="chat-main-layout">
                <div class="chat-left-side">
                    <div id="chat-messages" class="messages-box"></div>
                    <textarea id="chat-message-input" class="input-box" placeholder="Напишите сообщение..." onkeypress="handleKeyPress(event)"></textarea>

                    <div class="input-toolbar">
                        <button class="tool-btn" id="rec-btn" onclick="toggleVoiceRecord()">🎤 Голосовое</button>
                        <button class="ptt-button" style="padding:4px 15px; flex:none;" onclick="sendTextMessage()">Send 💌</button>
                    </div>
                </div>

                <div class="chat-right-side">
                    <div class="avatar-box">👑</div>
                    <div style="font-size:9px; font-weight:bold;" id="my-name-display">Я</div>

                    <div class="video-stream-box" id="peer-video-container" onclick="toggleFullscreenVideo()">
                        <div class="video-placeholder" id="video-placeholder">Рация выкл</div>
                        <video id="peer-video-element" autoplay playsinline muted></video>
                    </div>

                    <div class="avatar-box">🎀</div>
                    <div style="font-size:9px; font-weight:bold;">Собеседник</div>
                </div>
            </div>

            <div class="ptt-bar">
                <button id="ptt-button" class="ptt-button" onclick="toggleAudioPTT()">🎙️ ГОЛОС</button>
                <button id="vptt-button" class="ptt-button" style="background: linear-gradient(90deg, #a3c4f3 0%, #c8b6ff 100%);" onclick="toggleVideoPTT()">📹 ВИДЕО</button>
            </div>
        </div>
    </div>

    <audio id="peer-audio-element" autoplay style="display:none;"></audio>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDo3LytnfDm-hAPL2RxTpz3VteGmTcSmAc",
            authDomain: "icqnovpn.firebaseapp.com",
            databaseURL: "https://icqnovpn-default-rtdb.firebaseio.com",
            projectId: "icqnovpn",
            storageBucket: "icqnovpn.firebasestorage.app",
            messagingSenderId: "624335054201",
            appId: "1:624335054201:web:69556400be41283b157ba8"
        };

        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        let myUserId = localStorage.getItem('icq_uid') || 'u_' + Math.random().toString(36).substr(2, 5);
        localStorage.setItem('icq_uid', myUserId);

        let myUsername = '', currentRoom = '', roomRef = null, signalRef = null;
        let isVoiceRecording = false, voiceRecorder = null, voiceChunks = [];
        let isAudioPTTActive = false, isVideoPTTActive = false;
        let peerConnection = null, localStream = null;

        /* МЕЖДУНАРОДНЫЕ STUN И TURN СЕРВЕРЫ (ДЛЯ ПРОБИТИЯ БЛОКИРОВОК КОРЕЯ-РФ) */
        const rtcServers = {
            iceServers: [
                { urls: "stun:stun.l.google.com:19302" },
                { urls: "stun:stun1.l.google.com:19302" },
                { urls: "stun:stun.services.mozilla.com" },
                { urls: "stun:global.stun.twilio.com:3478" },
                // Открытые TURN-серверы для обхода NAT/DPI:
                {
                    urls: "turn:openrelay.metered.ca:80",
                    username: "openrelayproject",
                    credential: "openrelayproject"
                },
                {
                    urls: "turn:openrelay.metered.ca:443",
                    username: "openrelayproject",
                    credential: "openrelayproject"
                }
            ],
            iceCandidatePoolSize: 10
        };

        function escapeHTML(str) {
            return str ? str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)) : '';
        }

        window.addEventListener('load', () => {
            setTimeout(() => {
                const loader = document.getElementById('loading-screen');
                if (loader) loader.style.display = 'none';
            }, 500);

            const savedUname = localStorage.getItem('icq_uname');
            const savedRoom = localStorage.getItem('icq_room');
            if (savedUname && savedRoom) {
                document.getElementById('username-input').value = savedUname;
                document.getElementById('room-input').value = savedRoom;
                startSession();
            }
        });

        function startSession() {
            const uname = document.getElementById('username-input').value.trim();
            const room = document.getElementById('room-input').value.trim();
            if (!uname || !room) return alert("Введите имя и комнату!");

            myUsername = uname;
            currentRoom = room.toLowerCase().replace(/[^a-z0-9_-]/g, '');

            localStorage.setItem('icq_uname', myUsername);
            localStorage.setItem('icq_room', currentRoom);

            document.getElementById('my-name-display').innerText = myUsername;
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('chat-screen').classList.add('active');
            document.getElementById('exit-btn').style.display = 'block';

            roomRef = database.ref('rooms/' + currentRoom + '/messages');
            signalRef = database.ref('rooms/' + currentRoom + '/signal/' + myUserId);

            // Слушаем новые сообщения
            roomRef.limitToLast(40).on('child_added', (snapshot) => {
                renderIncomingMessage(snapshot.val());
            });

            // Слушаем WebRTC сигналы от собеседника
            database.ref('rooms/' + currentRoom + '/signal').on('child_added', (snapshot) => {
                if (snapshot.key !== myUserId) handleSignalIncoming(snapshot.val());
            });
            database.ref('rooms/' + currentRoom + '/signal').on('child_changed', (snapshot) => {
                if (snapshot.key !== myUserId) handleSignalIncoming(snapshot.val());
            });
        }

        function logout() {
            localStorage.clear();
            location.reload();
        }

        function sendMessagePayload(data) {
            if (!roomRef) return;
            roomRef.push({
                id: 'm_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
                uid: myUserId,
                sender: myUsername,
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                ...data
            });
        }

        function sendTextMessage() {
            const input = document.getElementById('chat-message-input');
            const text = input.value.trim();
            if (!text) return;
            sendMessagePayload({ type: 'text', content: text });
            input.value = '';
        }

        const renderedMsgs = new Set();
        function renderIncomingMessage(data) {
            if (!data || (data.id && renderedMsgs.has(data.id))) return;
            if (data.id) renderedMsgs.add(data.id);

            const box = document.getElementById('chat-messages');
            const isSelf = data.uid === myUserId;
            const msgDiv = document.createElement('div');
            msgDiv.className = 'msg-item';

            let contentHTML = '';
            if (data.type === 'text') contentHTML = escapeHTML(data.content);
            else if (data.type === 'image') contentHTML = `<img src="${data.content}">`;
            else if (data.type === 'audio') contentHTML = `<audio src="${data.content}" controls style="max-width:180px;"></audio>`;

            msgDiv.innerHTML = `
                <div class="msg-header-text ${isSelf ? 'self' : ''}">${escapeHTML(data.sender)} (${data.timestamp}):</div>
                <div class="msg-content">${contentHTML}</div>
            `;
            box.appendChild(msgDiv);
            box.scrollTop = box.scrollHeight;
        }

        /* WEBRTC ТРАНСЛЯЦИЯ */
        function cleanupPeerConnection() {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
            }
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }
            const videoEl = document.getElementById('peer-video-element');
            const placeholder = document.getElementById('video-placeholder');
            if (videoEl) {
                videoEl.style.display = 'none';
                videoEl.srcObject = null;
            }
            if (placeholder) {
                placeholder.style.display = 'block';
                placeholder.innerText = 'Рация выкл';
            }
        }

        function initPeerConnection() {
            if (peerConnection) peerConnection.close();
            peerConnection = new RTCPeerConnection(rtcServers);

            peerConnection.ontrack = (event) => {
                const videoEl = document.getElementById('peer-video-element');
                const audioEl = document.getElementById('peer-audio-element');
                const placeholder = document.getElementById('video-placeholder');

                if (event.track.kind === 'video') {
                    placeholder.style.display = 'none';
                    videoEl.style.display = 'block';
                    videoEl.muted = false;
                    videoEl.srcObject = event.streams[0];
                    videoEl.play().catch(e => console.log(e));
                } else if (event.track.kind === 'audio') {
                    audioEl.srcObject = event.streams[0];
                    audioEl.play().catch(e => console.log(e));
                }
            };

            peerConnection.onicecandidate = (event) => {
                if (event.candidate && signalRef) {
                    signalRef.set({ type: 'candidate', candidate: JSON.stringify(event.candidate) });
                }
            };
        }

        async function handleSignalIncoming(data) {
            if (!data) return;
            try {
                if (data.type === 'offer') {
                    initPeerConnection();
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(JSON.parse(data.offer)));
                    const answer = await peerConnection.createAnswer();
                    await peerConnection.setLocalDescription(answer);
                    signalRef.set({ type: 'answer', answer: JSON.stringify(answer) });
                } else if (data.type === 'answer' && peerConnection) {
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(JSON.parse(data.answer)));
                } else if (data.type === 'candidate' && peerConnection) {
                    await peerConnection.addIceCandidate(new RTCIceCandidate(JSON.parse(data.candidate)));
                } else if (data.type === 'stop') {
                    cleanupPeerConnection();
                }
            } catch (e) { console.error("Signaling error:", e); }
        }

        /* 1. ВКЛЮЧЕНИЕ ГОЛОСОВОЙ РАЦИИ */
        async function toggleAudioPTT() {
            const btn = document.getElementById('ptt-button');
            if (!isAudioPTTActive) {
                stopPTTAll();
                try {
                    localStream = await navigator.mediaDevices.getUserMedia({ 
                        audio: { echoCancellation: true, noiseSuppression: true } 
                    });

                    initPeerConnection();
                    localStream.getTracks().forEach(track => peerConnection.addTrack(track, localStream));

                    const offer = await peerConnection.createOffer();
                    await peerConnection.setLocalDescription(offer);
                    signalRef.set({ type: 'offer', offer: JSON.stringify(offer) });

                    isAudioPTTActive = true;
                    btn.classList.add('active');
                    btn.innerText = '🔴 ВЕЩАНИЕ (АУДИО)';
                } catch (e) {
                    alert("Ошибка микрофона! Убедитесь, что сайт открыт по HTTPS и доступ разрешен.");
                }
            } else {
                stopPTTAll();
            }
        }

        /* 2. ВКЛЮЧЕНИЕ ВИДЕО-РАЦИИ */
        async function toggleVideoPTT() {
            const btn = document.getElementById('vptt-button');
            if (!isVideoPTTActive) {
                stopPTTAll();
                try {
                    // Запрашиваем камеру и микрофон с оптимальным размером для рации
                    localStream = await navigator.mediaDevices.getUserMedia({ 
                        video: { width: { ideal: 320 }, height: { ideal: 240 }, frameRate: { max: 15 }, facingMode: 'user' },
                        audio: { echoCancellation: true, noiseSuppression: true } 
                    });

                    // Показываем локальное видео отправителю сразу!
                    const videoEl = document.getElementById('peer-video-element');
                    const placeholder = document.getElementById('video-placeholder');
                    placeholder.style.display = 'none';
                    videoEl.style.display = 'block';
                    videoEl.muted = true; // Свое видео не озвучиваем
                    videoEl.srcObject = localStream;

                    initPeerConnection();
                    localStream.getTracks().forEach(track => peerConnection.addTrack(track, localStream));

                    const offer = await peerConnection.createOffer();
                    await peerConnection.setLocalDescription(offer);
                    signalRef.set({ type: 'offer', offer: JSON.stringify(offer) });

                    isVideoPTTActive = true;
                    btn.classList.add('active');
                    btn.innerText = '🔴 ВЕЩАНИЕ (ВИДЕО)';
                } catch (e) {
                    alert("Ошибка доступа к камере! Проверьте, разрешен ли доступ к камере в настройках браузера.");
                }
            } else {
                stopPTTAll();
            }
        }

        function stopPTTAll() {
            cleanupPeerConnection();
            if (signalRef) signalRef.set({ type: 'stop' });

            isAudioPTTActive = false;
            isVideoPTTActive = false;

            const audioBtn = document.getElementById('ptt-button');
            const videoBtn = document.getElementById('vptt-button');
            if (audioBtn) { audioBtn.classList.remove('active'); audioBtn.innerText = '🎙️ ГОЛОС'; }
            if (videoBtn) { videoBtn.classList.remove('active'); videoBtn.innerText = '📹 ВИДЕО'; }
        }

        function toggleFullscreenVideo() {
            document.getElementById('peer-video-container').classList.toggle('fullscreen');
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendTextMessage(); }
        }

        /* ГОЛОСОВЫЕ СООБЩЕНИЯ */
        async function toggleVoiceRecord() {
            const btn = document.getElementById('rec-btn');
            if (!isVoiceRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    voiceRecorder = new MediaRecorder(stream);
                    voiceChunks = [];
                    voiceRecorder.ondataavailable = e => { if (e.data.size > 0) voiceChunks.push(e.data); };
                    voiceRecorder.onstop = () => {
                        const blob = new Blob(voiceChunks, { type: 'audio/webm' });
                        const reader = new FileReader();
                        reader.onloadend = () => sendMessagePayload({ type: 'audio', content: reader.result });
                        reader.readAsDataURL(blob);
                        stream.getTracks().forEach(track => track.stop());
                    };
                    voiceRecorder.start();
                    isVoiceRecording = true;
                    btn.innerText = '🔴 Стоп';
                } catch (e) { alert("Ошибка записи голоса!"); }
            } else {
                isVoiceRecording = false;
                btn.innerText = '🎤 Голосовое';
                if (voiceRecorder) voiceRecorder.stop();
            }
        }

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (evt) => sendMessagePayload({ type: 'image', content: evt.target.result });
            reader.readAsDataURL(file);
            e.target.value = '';
        }
    </script>
</body>
</html>
